# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# Ren'Py generated directories
/game/saves/
/game/cache/

# Compiled Ren'Py scripts
/game/**/*.rpyc
/game/**/*.rpymc
/game/**/*.rpyb

# Temporary/generated Ren'Py files
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Logs and generated files
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files
/dialogue.tab
/dialogue.txt
/strings.json

# Android signing keys - NEVER COMMIT
*.keystore
*.jks

# Build outputs
*.apk
*.aab

# OS junk
Thumbs.db
.DS_Store

# Editor settings
.vscode/
**/.vscode/